<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NavIndicator">

        <item name="android:width">52dp</item>
        <item name="android:height">52dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>

    </style>

    <style name="NavIndicatorShape">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>

    </style>

    <style name="NavTextActive">

        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#32C766</item>

    </style>

    <style name="NavTextInactive">

        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#9AA0AC</item>

    </style>

    <!-- Top Rounded Corners for Bottom Navigation -->
    <style name="ShapeAppearanceOverlay.BottomNav.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>