<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_neutral">

    <!-- NO INTERNET BANNER -->
    <LinearLayout
        android:id="@+id/ll_no_internet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EF4444"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Koneksi terputus. Mencoba menghubungkan kembali..."
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:fontFamily="@font/manrope_semibold" />
    </LinearLayout>

    <!-- ================= CONTENT ================= -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_no_internet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NAVBAR PREMIUM -->
    <LinearLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="wrap_content"
        android:layout_height="65dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_navbar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nav Item 1: Home -->
        <LinearLayout
            android:id="@+id/nav_home_container"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@android:color/transparent">
            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_home"
                android:scaleType="fitCenter"
                android:contentDescription="Home"/>
            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Home"
                android:visibility="gone"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_semibold"/>
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Nav Item 2: Sensor -->
        <LinearLayout
            android:id="@+id/nav_sensor_container"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@android:color/transparent">
            <ImageButton
                android:id="@+id/nav_sensor"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_sensor"
                android:scaleType="fitCenter"
                android:contentDescription="Sensor"/>
            <TextView
                android:id="@+id/nav_sensor_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sensor"
                android:visibility="gone"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_semibold"/>
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Nav Item 3: History (with badge) -->
        <LinearLayout
            android:id="@+id/nav_history_container"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@android:color/transparent">
            <ImageButton
                android:id="@+id/nav_history"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_history"
                android:scaleType="fitCenter"
                android:contentDescription="History"/>
            <TextView
                android:id="@+id/nav_history_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="History"
                android:visibility="gone"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_semibold"/>
        </LinearLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp"/>

        <!-- Nav Item 4: Settings -->
        <LinearLayout
            android:id="@+id/nav_settings_container"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="@android:color/transparent">
            <ImageButton
                android:id="@+id/nav_settings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_settings"
                android:scaleType="fitCenter"
                android:contentDescription="Setting"/>
            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Setting"
                android:visibility="gone"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:fontFamily="@font/manrope_semibold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>