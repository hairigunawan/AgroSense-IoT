<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lupa Password"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukkan email yang terdaftar. Kami akan mengirimkan tautan untuk mereset kata sandi Anda. Harap periksa juga folder Spam."
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_forgot_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_modern"
                android:hint="Email Anda"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_dark"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_medium" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_reset"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="Kirim Tautan"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/manrope_bold"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="13dp"
            app:elevation="0dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/btn_cancel_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textColor="@color/text_light"
            android:textSize="15sp"
            android:fontFamily="@font/manrope_semibold"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_button_cancel">
        </TextView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>