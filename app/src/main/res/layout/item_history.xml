<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    android:layout_marginTop="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivIconHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_water_drop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvDateHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="24 Januari 2025"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#212121"
            app:layout_constraintStart_toEndOf="@id/ivIconHistory"
            app:layout_constraintTop_toTopOf="@id/ivIconHistory"
            app:layout_constraintEnd_toStartOf="@id/tvTimeHistory"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvStatusHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELESAI"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvDateHistory"
            app:layout_constraintTop_toBottomOf="@id/tvDateHistory"/>

        <TextView
            android:id="@+id/tvTimeHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:00"
            android:textSize="12sp"
            android:textColor="#757575"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDateHistory"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
