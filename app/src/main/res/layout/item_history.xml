<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="8dp"
    app:strokeColor="#F1F1F1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivStatusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/dot_green"/>

            <TextView
                android:id="@+id/tvKategori"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/manrope_bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="PENYIRAMAN OTOMATIS"/>
        </LinearLayout>

        <!-- Judul -->
        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#2E2E2E"
            android:textSize="14sp"
            android:fontFamily="@font/manrope_bold"
            tools:text="Pompa Menyiram Tanaman"/>

        <!-- Deskripsi -->
        <TextView
            android:id="@+id/tvDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#666666"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/manrope_regular"
            tools:text="Tanah mencapai batas kering (30%) sehingga pompa menyala secara otomatis dan berhenti setelah kelembapan mencapai 42%."/>

        <!-- Footer -->
        <LinearLayout
            android:id="@+id/llFooterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTanggalMulai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="@font/manrope_medium"
                tools:text="Mulai: 12 Juni 2026 17:20"/>

            <TextView
                android:id="@+id/tvTanggalSelesai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="@font/manrope_medium"
                tools:text="Selesai: 12 Juni 2026 17:20"/>

            <!-- Durasi & Status (Ditaruh di kanan ujung) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvDurasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_medium"
                    tools:text="10 DETIK"/>
                
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/dot_gray"/>

                <TextView
                    android:id="@+id/tvStatusAkhir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:fontFamily="@font/manrope_medium"
                    tools:text="BERHASIL"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>