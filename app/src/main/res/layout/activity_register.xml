<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_neutral"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingVertical="26dp">

        <ImageView
            android:id="@+id/iv_logo_reg"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_reg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Akun"
            android:textColor="@color/text_dark"
            android:textSize="28sp"
            android:fontFamily="@font/manrope_extrabold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo_reg" />

        <TextView
            android:id="@+id/tv_subtitle_reg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mulai kelola irigasi pintar Anda"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            android:fontFamily="@font/manrope_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title_reg" />

        <!-- Input Nama -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle_reg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name_register"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:background="@drawable/bg_input_modern"
                android:hint="Nama Lengkap"
                android:inputType="textPersonName"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_dark"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_medium" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Input Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email_reg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/til_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email_register"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:background="@drawable/bg_input_modern"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_dark"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_medium" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Input Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password_reg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#94A3B8"
            app:layout_constraintTop_toBottomOf="@id/til_email_reg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_register"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:background="@drawable/bg_input_modern"
                android:hint="Kata Sandi"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_dark"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:fontFamily="@font/manrope_medium" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- TOMBOL DAFTAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:text="Daftar"
            android:textAllCaps="false"
            app:layout_constraintTop_toBottomOf="@id/til_password_reg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_register"
            style="@style/Widget.App.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Daftar dengan Google"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:layout_constraintTop_toBottomOf="@id/btn_register" />

        <ProgressBar
            android:id="@+id/pb_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/green_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Teks Login -->
        <LinearLayout
            android:id="@+id/ll_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="Sudah punya akun? "
                android:textColor="@color/text_light" />

            <TextView
                android:id="@+id/tv_go_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Masuk"
                android:textColor="@color/green_button"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingStart="4dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>