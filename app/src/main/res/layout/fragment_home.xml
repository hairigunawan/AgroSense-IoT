<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="100dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ================= HEADER ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/card_notification"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 Oktober 2026"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope_medium" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Pagi, Alex"
                        android:fontFamily="@font/manrope_extrabold"
                        android:textColor="#0F172A"
                        android:textSize="22sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_notification"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/card_profile_image"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_notification"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/notification"
                        app:tint="#0F172A" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile_image"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_profile_home"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user" />
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================= WEATHER CARD ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutWeatherBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Premium Navy Overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#730F172A" />

                    <LinearLayout
                        android:id="@+id/layout_loc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_glass_card"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_sun"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ujung Batu"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_semibold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="24dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_glass_card"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_history"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Live"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_semibold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_extrabold"
                        android:text="30°C"
                        android:textColor="#FFFFFF"
                        android:textSize="56sp"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layout_loc" />

                    <TextView
                        android:id="@+id/tvHomeWeatherCondition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cerah Berawan"
                        android:textColor="#E2E8F0"
                        android:textSize="16sp"
                        android:fontFamily="@font/manrope_medium"
                        android:layout_marginStart="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvWeatherTemp" />

                    <!-- Center 3D Icon -->
                    <ImageView
                        android:id="@+id/ivWeatherIcon3D"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/cerah"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvWeatherTemp"
                        app:layout_constraintBottom_toBottomOf="@id/tvHomeWeatherCondition" />

                    <!-- Bottom Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginBottom="24dp"
                        android:weightSum="2"
                        app:layout_constraintTop_toBottomOf="@id/tvHomeWeatherCondition"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <!-- Kelembapan Udara Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_glass_card"
                            android:backgroundTint="#F8FAFC"
                            android:padding="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="#EFF6FF"
                                android:padding="8dp"
                                android:src="@drawable/ic_water_drop"
                                app:tint="#3B82F6" />
                                
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">
                                
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Kelembapan"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope_medium" />

                                <TextView
                                    android:id="@+id/tvWeatherHumidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45%"
                                    android:textColor="#0F172A"
                                    android:textSize="16sp"
                                    android:fontFamily="@font/manrope_extrabold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Kecepatan Angin Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_glass_card"
                            android:backgroundTint="#F8FAFC"
                            android:padding="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="#ECFDF5"
                                android:padding="8dp"
                                android:src="@drawable/ic_sun"
                                app:tint="#10B981" />
                                
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">
                                
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Angin"
                                    android:textColor="#64748B"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/manrope_medium" />

                                <TextView
                                    android:id="@+id/tvWindSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 km/j"
                                    android:textColor="#0F172A"
                                    android:textSize="16sp"
                                    android:fontFamily="@font/manrope_extrabold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SOIL STATUS TITLE ================= -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Status Tanah"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detail"
                    android:textColor="#3B82F6"
                    android:textSize="14sp"
                    android:fontFamily="@font/manrope_bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================= STATUS GRID ================= -->
            <!-- Baris 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- MOISTURE / SUHU TANAH -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_suhu_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#ECFDF5"
                            android:padding="12dp"
                            android:src="@drawable/ic_thermostat"
                            app:tint="#10B981"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_chip_light_green"
                            android:fontFamily="@font/manrope_bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Normal"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tv_suhu_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/manrope_medium"
                            android:text="Suhu Tanah"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_suhu_icon"/>

                        <TextView
                            android:id="@+id/suhuValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:fontFamily="@font/manrope_extrabold"
                            android:text="32°C"
                            android:textColor="#0F172A"
                            android:textSize="28sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_suhu_title"/>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_graph_green"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SIGNAL / KELEMBAPAN TANAH -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <ImageView
                            android:id="@+id/iv_moisture_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#EFF6FF"
                            android:padding="12dp"
                            android:src="@drawable/ic_water_drop"
                            app:tint="#3B82F6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tvMoistureStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_chip_light_blue"
                            android:backgroundTint="#EFF6FF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Normal"
                            android:textColor="#3B82F6"
                            android:textSize="11sp"
                            android:fontFamily="@font/manrope_bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tv_moisture_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="16dp"
                            android:text="Air Tanah"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_medium"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_moisture_icon"/>

                        <TextView
                            android:id="@+id/kelembapanTanahValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="60%"
                            android:textColor="#0F172A"
                            android:textSize="28sp"
                            android:fontFamily="@font/manrope_extrabold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_moisture_title"/>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_graph_blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Baris 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- HUMIDITY (AIR) / KELEMBAPAN UDARA -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E2E8F0"
                    app:cardBackgroundColor="#FFFFFF">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- Left Side Content -->
                        <ImageView
                            android:id="@+id/iv_air_humidity_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#EFF6FF"
                            android:padding="12dp"
                            android:src="@drawable/ic_cloud"
                            app:tint="#3B82F6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tv_air_humidity_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Kelembapan Udara"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_medium"
                            app:layout_constraintStart_toEndOf="@id/iv_air_humidity_icon"
                            app:layout_constraintTop_toTopOf="@id/iv_air_humidity_icon"
                            app:layout_constraintBottom_toTopOf="@id/kelembapanUdaraValue"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/kelembapanUdaraValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="45%"
                            android:textColor="#0F172A"
                            android:textSize="28sp"
                            android:fontFamily="@font/manrope_extrabold"
                            app:layout_constraintStart_toEndOf="@id/iv_air_humidity_icon"
                            app:layout_constraintTop_toBottomOf="@id/tv_air_humidity_title"
                            app:layout_constraintBottom_toBottomOf="@id/iv_air_humidity_icon"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Kondisi kelembapan udara berada dalam batas optimal."
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:fontFamily="@font/manrope_medium"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/progress_humidity"
                            app:layout_constraintTop_toBottomOf="@id/iv_air_humidity_icon"/>

                        <!-- Right Side Progress -->
                        <ProgressBar
                            android:id="@+id/progress_humidity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:max="100"
                            android:progress="45"
                            android:progressDrawable="@drawable/bg_humidity_progress"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Optimal"
                            android:textColor="#3B82F6"
                            android:textSize="13sp"
                            android:fontFamily="@font/manrope_bold"
                            app:layout_constraintStart_toStartOf="@id/progress_humidity"
                            app:layout_constraintEnd_toEndOf="@id/progress_humidity"
                            app:layout_constraintTop_toTopOf="@id/progress_humidity"
                            app:layout_constraintBottom_toBottomOf="@id/progress_humidity"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= DEVICE CONTROL ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Kontrol Perangkat"
                android:textColor="#0F172A"
                android:textSize="18sp" />

            <!-- POMPA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#F8FAFC"
                            android:padding="12dp"
                            android:src="@drawable/ic_settings"
                            app:tint="#64748B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mode Operasi"
                                android:textColor="#64748B"
                                android:textSize="13sp"
                                android:fontFamily="@font/manrope_medium"/>

                            <TextView
                                android:id="@+id/tvModeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Otomatis"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:fontFamily="@font/manrope_bold"/>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="20dp"
                        android:background="#F1F5F9" />

                    <!-- Baris Kontrol Manual -->
                    <LinearLayout
                        android:id="@+id/layout_pompa_manual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivPumpIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#ECFDF5"
                            android:padding="12dp"
                            android:src="@drawable/ic_water_drop"
                            app:tint="#10B981" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saklar Pompa"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:fontFamily="@font/manrope_bold"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/viewStatusDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_green" />

                                <TextView
                                    android:id="@+id/tvStatusPenyiraman"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="Mati"
                                    android:textColor="#64748B"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/manrope_medium"/>

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPompa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:useMaterialThemeColors="true" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>