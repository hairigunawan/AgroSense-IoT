<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_weather_gradient">

    <!-- Dynamic Gradient (Background already has bg_weather_gradient, we will animate it) -->
    
    <!-- Background Glow Effect -->
    <View
        android:id="@+id/vGlow"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_circle"
        android:alpha="0.15"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <!-- Clouds Layer 1 -->
    <ImageView
        android:id="@+id/ivCloud1"
        android:layout_width="160dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.4"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="-30dp"
        android:layout_marginTop="40dp" />

    <!-- Clouds Layer 2 -->
    <ImageView
        android:id="@+id/ivCloud2"
        android:layout_width="220dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.25"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="-50dp"
        android:layout_marginTop="120dp" />

    <!-- Rain Particles Layer (Thin lines) -->
    <FrameLayout
        android:id="@+id/flRain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View android:id="@+id/rain1" android:layout_width="2dp" android:layout_height="80dp" android:background="#66FFFFFF" android:layout_marginStart="80dp" android:layout_marginTop="-80dp" />
        <View android:id="@+id/rain2" android:layout_width="1.5dp" android:layout_height="60dp" android:background="#44FFFFFF" android:layout_marginStart="160dp" android:layout_marginTop="-150dp"/>
        <View android:id="@+id/rain3" android:layout_width="2.5dp" android:layout_height="90dp" android:background="#55FFFFFF" android:layout_marginStart="240dp" android:layout_marginTop="-50dp"/>
        <View android:id="@+id/rain4" android:layout_width="1dp" android:layout_height="50dp" android:background="#33FFFFFF" android:layout_marginStart="320dp" android:layout_marginTop="-100dp"/>
    </FrameLayout>

    <!-- Main Scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/llHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvLocationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Tungkaran"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Temperature -->
            <TextView
                android:id="@+id/tvMainTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="27°"
                android:textColor="@color/white"
                android:textSize="100sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/llHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Condition -->
            <TextView
                android:id="@+id/tvCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berawan"
                android:textColor="@color/white"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/tvMainTemp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- High Low -->
            <TextView
                android:id="@+id/tvHighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="H: 32°  L: 24°"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tvCondition"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Feels Like -->
            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Terasa seperti 32°"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvHighLow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:text="Hari yang cukup lembap dengan potensi hujan ringan di sore hari."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/tvFeelsLike"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Rain Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cvRainPrediction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvRainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hujan Segera Turun"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvRainSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sekitar 15 menit lagi"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tvRainTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvRainPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42%"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Hourly -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cvHourly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_glass_card"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toBottomOf="@id/cvRainPrediction"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHourlyModern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_hourly_modern" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Daily -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cvDaily"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_glass_card"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/cvHourly"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:id="@+id/llDailyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <include layout="@layout/item_daily_modern" />
                    <include layout="@layout/item_daily_modern" />
                    <include layout="@layout/item_daily_modern" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>